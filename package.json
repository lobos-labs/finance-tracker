{
  "name": "finance-tracker",
  "productName": "Finance Tracker",
  "version": "0.1.0",
  "description": "Personal finance tracker that syncs bank accounts and categorizes spending with Claude.",
  "private": true,
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "predev": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prestart": "node node_modules/electron/install.js",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:plain && npm run test:encrypted",
    "test:plain": "node --import ./test/ts-esm.mjs --test \"test/*.test.ts\"",
    "test:encrypted": "node --import ./test/ts-esm.mjs --import ./test/encrypted.mjs --test \"test/*.test.ts\"",
    "test:utc": "node --import ./test/ts-esm.mjs --import ./test/utc.mjs --test \"test/*.test.ts\"",
    "test:electron": "node scripts/test-electron.cjs",
    "icon": "electron scripts/make-icon.cjs",
    "shortcut": "electron-vite build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1",
    "predist": "node node_modules/electron/install.js",
    "dist": "electron-vite build && electron-builder --win",
    "predist:mac": "node node_modules/electron/install.js",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:open": "node scripts/dist-open.cjs",
    "e2e:connector": "node --import ./test/ts-esm.mjs scripts/connector-e2e.ts"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.11.3",
    "electron-builder": "26.17.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "electron-updater": "6.8.10",
    "papaparse": "^5.7.0"
  },
  "license": "AGPL-3.0-or-later"
}
